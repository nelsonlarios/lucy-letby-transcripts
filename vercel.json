{
	"rewrites": [
		{
			"source": "/((?!data/|pagefind/|originals/).*)",
			"destination": "/index.html"
		}
	],
	"headers": [
		{
			"source": "/pagefind/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/data/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		}
	]
}
