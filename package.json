{
	"name": "lucy-letby-transcripts",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"transcripts:json": "tsx scripts/generate-transcripts-json.ts",
		"transcripts:download": "node scripts/download-transcripts.mjs",
		"transcripts:ingest": "tsx scripts/ingest-transcripts.ts",
		"transcripts:index": "pagefind --site generated/pagefind-source --output-path public/pagefind",
		"transcripts:build": "pnpm transcripts:ingest && pnpm transcripts:index"
	},
	"dependencies": {
		"@fontsource-variable/source-sans-3": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@mantine/core": "^9.6.2",
		"@mantine/hooks": "^9.6.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^7.18.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"cheerio": "^1.2.0",
		"jsdom": "^30.1.0",
		"pagefind": "^1.5.2",
		"pdfjs-dist": "^6.3.289",
		"postcss": "^8.5.28",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vite-plugin-static-copy": "^4.1.1",
		"vitest": "^5.0.1"
	}
}
